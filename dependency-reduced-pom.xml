<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.keyforge.iiq</groupId>
  <artifactId>iiq-migration-tool</artifactId>
  <name>SailPoint IdentityIQ Migration Tool</name>
  <version>1.0.0-SNAPSHOT</version>
  <description>Standalone command-line utility that extracts data from SailPoint
        IdentityIQ via its SCIM v2 REST API. Not a web server.</description>
  <build>
    <finalName>iiq-migration-tool</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <excludes>
            <exclude>com/keyforge/nativeiiq/**</exclude>
          </excludes>
          <testExcludes>
            <testExclude>com/keyforge/nativeiiq/**</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.plugin.version}</version>
        <configuration>
          <argLine>-Djava.io.tmpdir=${project.build.directory}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>${main.class}</mainClass>
                </transformer>
                <transformer />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
            <executions>
              <execution>
                <id>compile-native</id>
                <phase>compile</phase>
                <goals>
                  <goal>compile</goal>
                </goals>
                <configuration>
                  <release>${iiq.java.release}</release>
                  <includes>
                    <include>com/keyforge/nativeiiq/**</include>
                  </includes>
                  <excludes>
                    <exclude>none</exclude>
                  </excludes>
                </configuration>
              </execution>
              <execution>
                <id>testcompile-native</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>testCompile</goal>
                </goals>
                <configuration>
                  <release>${iiq.java.release}</release>
                  <testIncludes>
                    <testInclude>com/keyforge/nativeiiq/**</testInclude>
                  </testIncludes>
                  <testExcludes>
                    <testExclude>none</testExclude>
                  </testExcludes>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>package-iiq-plugin</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <property />
                    <delete />
                    <mkdir />
                    <jar />
                    <copy>
                      <fileset />
                    </copy>
                    <mkdir />
                    <zip />
                    <echo />
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <dependencies>
        <dependency>
          <groupId>com.sailpoint</groupId>
          <artifactId>identityiq</artifactId>
          <version>provided-by-iiq</version>
          <scope>system</scope>
          <systemPath>${project.basedir}/lib/identityiq.jar</systemPath>
        </dependency>
        <dependency>
          <groupId>javax.ws.rs</groupId>
          <artifactId>javax.ws.rs-api</artifactId>
          <version>2.1.1</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <properties>
        <iiq.java.release>8</iiq.java.release>
        <plugin.zip.version>1.0</plugin.zip.version>
        <plugin.name>KeyForgeNativeIIQ</plugin.name>
      </properties>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-api</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-params</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.sailpoint</groupId>
      <artifactId>identityiq</artifactId>
      <version>provided-by-iiq</version>
      <scope>system</scope>
      <systemPath>D:\iiq-migration-tool/lib/identityiq.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>javax.ws.rs</groupId>
      <artifactId>javax.ws.rs-api</artifactId>
      <version>2.1.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <main.class>com.keyforge.iiq.Main</main.class>
    <shade.plugin.version>3.6.0</shade.plugin.version>
    <surefire.plugin.version>3.2.5</surefire.plugin.version>
    <jackson.version>2.17.2</jackson.version>
    <postgresql.version>42.7.4</postgresql.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <duckdb.version>1.1.3</duckdb.version>
  </properties>
</project>
