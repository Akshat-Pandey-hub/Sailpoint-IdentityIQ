# ─────────────────────────────────────────────────────────────────────────────
# KF Agent environment file (TEMPLATE — no real secrets here).
# Copy to "kfagent.env" on the server and fill in the real values. Then load it:
#     set -a; source /opt/kfagent/kfagent.env; set +a      # for a manual run
# or reference it from a systemd service:  EnvironmentFile=/opt/kfagent/kfagent.env
# Keep the real file private:  chmod 600 kfagent.env
# ─────────────────────────────────────────────────────────────────────────────

# ── IdentityIQ connection (REQUIRED for start-kfagent AND every extract-*-db job) ──
IIQ_BASE_URL=https://<IIQ_HOST>/identityiq
IIQ_USERNAME=<IIQ_USER>
IIQ_PASSWORD=<IIQ_PASSWORD>

# ── KF Agent REST bind (optional; these are the defaults) ──
KFAGENT_HOST=0.0.0.0
KFAGENT_PORT=8100

# ── Parquet query endpoints: where the .parquet datasets live (optional; default ./parquet-data) ──
# The Parquet query API is mounted on the SAME port (8100) as KF Agent. Datasets are produced by the
# extract-*-parquet jobs; until they exist, the endpoints respond but return no rows.
PARQUET_OUT_DIR=/opt/kfagent/parquet-data

# ── PostgreSQL (REQUIRED ONLY for the extract-*-db / derive-*-db jobs that write to Postgres; ──
# ──  NOT needed just to run start-kfagent) ──
PG_HOST=<PG_HOST>
PG_PORT=5432
PG_DATABASE=<PG_DATABASE>
PG_USERNAME=<PG_USER>
PG_PASSWORD=<PG_PASSWORD>
PG_SCHEMA=migration_test
# Native-sourced tables use a separate schema (optional; default iiq_native):
IIQ_NATIVE_SCHEMA=iiq_native
