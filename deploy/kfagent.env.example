# ─────────────────────────────────────────────────────────────────────────────
# KF Agent environment file (TEMPLATE — no real secrets here).
# Copy to "kfagent.env" on the server and fill in the real values. Then load it:
#     set -a; source /opt/kfagent/kfagent.env; set +a      # for a manual run
# or reference it from a systemd service:  EnvironmentFile=/opt/kfagent/kfagent.env
# Keep the real file private:  chmod 600 kfagent.env
# ─────────────────────────────────────────────────────────────────────────────

# ── IdentityIQ connection (REQUIRED for start-kfagent AND every extract-*-db job) ──
# IIQ_USERNAME / IIQ_PASSWORD are used ONLY for Part 1's own IdentityIQ login (never sent by REST callers).
IIQ_BASE_URL=https://<IIQ_HOST>/identityiq
IIQ_USERNAME=<IIQ_USER>
IIQ_PASSWORD=<IIQ_PASSWORD>

# ── KF Agent REST API credentials (REQUIRED for start-kfagent and start-rest) ──
# The client ID / client secret REST callers (e.g. Part 2, Postman) must send as HTTP Basic Auth.
# If either is missing, the service still starts but rejects every request with 401.
KFAGENT_USERNAME=<CLIENT_ID>
KFAGENT_PASSWORD=<CLIENT_SECRET>

# ── KF Agent REST bind (optional; these are the defaults) ──
KFAGENT_HOST=0.0.0.0
KFAGENT_PORT=8100

# ── Parquet query endpoints: where the .parquet datasets live (optional; default ./parquet-data) ──
# The Parquet query API is mounted on the SAME port (8100) as KF Agent. Datasets are produced by
# extract-native-parquet (see PARQUET.md); until they exist, the endpoints respond but return no rows.
PARQUET_OUT_DIR=/opt/kfagent/parquet-data

# ── Logging (optional; default debug) ──
#   debug  : everything - settings, each request with the credentials sent/expected, every IdentityIQ call
#            (usernames and the KF Agent credentials are printed; IIQ_PASSWORD is always hidden)
#   normal : only what ran and its result - service, result, login OK/failed, errors with their reason
#            (no usernames, passwords or settings)
#   off    : nothing
KF_LOG_LEVEL=debug
