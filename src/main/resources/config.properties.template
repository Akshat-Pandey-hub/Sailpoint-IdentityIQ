# =============================================================================
# IdentityIQ Migration Tool - configuration template
# =============================================================================
#
# Configuration is resolved in this order of precedence (first non-blank wins):
#   1. Environment variables                (PRIMARY, recommended)
#   2. JVM system properties (-Dkey=value)
#   3. An external properties file pointed to by IIQ_CONFIG_FILE
#
# To use a file:
#   1. Copy this template to a file OUTSIDE version control, e.g. config.properties
#   2. Fill in the values below.
#   3. Run with:  IIQ_CONFIG_FILE=/path/to/config.properties java -jar ...
#
# WARNING: never commit a file containing real credentials.
#          config.properties is already listed in .gitignore.
# =============================================================================

# Base URL of the IdentityIQ instance (trailing slash optional).
IIQ_BASE_URL=https://preview.keyforge.ai/identityiq/

# HTTP Basic Authentication credentials.
IIQ_USERNAME=
IIQ_PASSWORD=

# KF Agent REST credentials: the client ID / secret callers (Postman, Part 2) send as Basic Auth.
KFAGENT_USERNAME=
KFAGENT_PASSWORD=

# -----------------------------------------------------------------------------
# Logging level (optional; default debug):
#   debug  : everything - settings, each request with the credentials sent/expected, every IdentityIQ call
#            (usernames and the KF Agent credentials are printed; IIQ_PASSWORD is always hidden)
#   normal : only what ran and its result - service, result, login OK/failed, errors with their reason
#            (no usernames, passwords or settings)
#   off    : nothing
# -----------------------------------------------------------------------------
KF_LOG_LEVEL=debug
